#!/usr/bin/python
"""Expose the passive voice endpoint only to the vendor's own helper query.

The real Fcitx engine remains unchanged. All other gdbus requests and callers
use the system binary. No global PATH, D-Bus service or input-method setting
is replaced.
"""
import os
import socket
import sys

arguments = sys.argv[1:]
expected = ["call", "--session", "--dest", "org.fcitx.Fcitx5", "--object-path",
            "/controller", "--method", "org.fcitx.Fcitx.Controller1.CurrentInputMethod"]
scoped = (os.environ.get("TYPELESS_OMARCHY_ACTIVE") == "1" and
          os.environ.get("TYPELESS_OMARCHY_PID") == str(os.getppid()))
if scoped and arguments == expected:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if runtime.startswith("/"):
        try:
            with socket.socket(socket.AF_UNIX) as connection:
                connection.settimeout(0.2)
                connection.connect(runtime + "/typeless-voice-ime/inject.sock")
                connection.sendall(b'{"op":"ping"}')
                connection.shutdown(socket.SHUT_WR)
                reply = connection.recv(64)
            if reply in (b"UNFOCUSED", b"FOCUSED", b"FOCUSED_EDITABLE", b"PASSWORD"):
                print("('typeless-voice',)")
                raise SystemExit(0)
        except OSError:
            pass
os.execv("/usr/bin/gdbus", ["gdbus", *arguments])
