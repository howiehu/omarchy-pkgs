#!/usr/bin/python
"""Opt-in desktop integration for the packaged compatibility bridge."""
import base64
import json
import os
from pathlib import Path
import subprocess
import sys
import time

home = Path.home()
data = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "typeless-omarchy/package.json"
config = home / ".config/hypr/hyprland.lua"
desktop = data / "applications/typeless.desktop"
include = '\n-- typeless-omarchy begin\ndofile("/usr/share/typeless-omarchy/typeless.lua")\n-- typeless-omarchy end\n'

def call(method, signature=None, *args):
    command = ["busctl", "--user", "--json=short", "call", "org.fcitx.Fcitx5",
               "/controller", "org.fcitx.Fcitx.Controller1", method]
    if signature:
        command += [signature, *args]
    text = subprocess.check_output(command, text=True).strip()
    return json.loads(text)["data"] if text else None

def restart_input_method(previous):
    subprocess.run(["omarchy", "restart", "xcompose"], check=True)
    for _ in range(50):
        if subprocess.run(["fcitx5-remote", "--check"], stdout=subprocess.DEVNULL).returncode == 0:
            break
        time.sleep(0.1)
    if previous and previous != "typeless-voice":
        subprocess.run(["fcitx5-remote", "-s", previous], check=True)

if "--remove" in sys.argv:
    record = json.loads(state.read_text())
    # Refuse to clobber unrelated edits made after setup.
    if desktop.exists() and desktop.read_text() != record["desktop_installed"]:
        raise SystemExit("Desktop entry changed since setup; reconcile it before removal")
    if record["desktop_before"] is None:
        desktop.unlink(missing_ok=True)
    else:
        desktop.write_bytes(base64.b64decode(record["desktop_before"]))
    if config.exists() and include in config.read_text():
        config.write_text(config.read_text().replace(include, ""))
    state.unlink()
    restart_input_method(call("CurrentInputMethod")[0])
else:
    if state.exists():
        raise SystemExit("Compatibility setup already exists")
    if (state.parent / "install.json").exists():
        raise SystemExit("Remove the development prototype before packaged setup")
    if not config.exists() or not Path("/usr/lib/fcitx5/typeless-voice.so").exists():
        raise SystemExit("Install the compatibility package in an Omarchy session first")
    previous = call("CurrentInputMethod")[0]
    desktop_text = Path("/usr/share/applications/typeless.desktop").read_text().replace(
        "Exec=/opt/Typeless/typeless", "Exec=/usr/bin/typeless-omarchy").replace(
        "Name=Typeless\n", "Name=Typeless-Omarchy\n")
    record = dict(desktop_installed=desktop_text,
                  desktop_before=base64.b64encode(desktop.read_bytes()).decode() if desktop.exists() else None)
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps(record))
    desktop.parent.mkdir(parents=True, exist_ok=True)
    desktop.write_text(desktop_text)
    # Discover the newly installed addon; preserve the existing methods/layout.
    restart_input_method(previous)
subprocess.run(["update-desktop-database", str(desktop.parent)], check=True)
subprocess.run(["hyprctl", "reload"], check=True)
errors = subprocess.check_output(["hyprctl", "configerrors"], text=True).strip()
if errors:
    raise SystemExit(errors)
print("Typeless-Omarchy disabled" if "--remove" in sys.argv else "Typeless-Omarchy enabled; launch it from the application menu")
