# Package-local compatibility sources; no vendor binary redistribution.
pkgname=typeless-omarchy
pkgver=0.2.0
pkgrel=1
pkgdesc='Fcitx5 dictation bridge and opt-in Wayland desktop integration for Typeless'
arch=('x86_64')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('fcitx5' 'json-c' 'glib2' 'python' 'systemd' 'desktop-file-utils')
makedepends=('cmake' 'gcc' 'pkgconf')
checkdepends=('dbus')
optdepends=('typeless-bin: official Typeless application (AUR)'
            'omarchy: opt-in desktop integration')
options=('!debug')
source=('CMakeLists.txt'
        'voice.cpp'
        'typeless-voice-addon.conf'
        'gdbus'
        'typeless.lua'
        'typeless-omarchy'
        'typeless-omarchy-setup'
        'protocol.py'
        'input-probe.py'
        'native-insert.py'
        'live-input.py'
        'install-user.py'
        'stage-package.py'
        'validation.md'
        'LICENSE'
        'README.md')
