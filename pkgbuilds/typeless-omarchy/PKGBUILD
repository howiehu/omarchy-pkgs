pkgname=typeless-omarchy
pkgver=0.4.2
pkgrel=1
pkgdesc='Fcitx5 and Wayland compatibility for Typeless on Omarchy'
arch=('x86_64')
url='https://github.com/howiehu/typeless-omarchy'
license=('MIT')
depends=('fcitx5' 'json-c' 'glib2' 'python' 'systemd' 'desktop-file-utils')
makedepends=('cmake' 'gcc' 'pkgconf')
checkdepends=('dbus')
optdepends=('typeless-bin: separately installed official Typeless application (AUR)'
            'omarchy: explicit per-user desktop setup')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('dae16625ca72722fcaf3a8bdd16f19c49355b0e91dce93804e4f763f7d04c77b')

build() {
  cmake -S "$pkgname-$pkgver" -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
