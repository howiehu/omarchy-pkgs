#!/bin/bash
# The vendor's X11 helper hits BadWindow with native Wayland surfaces.
export TYPELESS_OMARCHY_PID=$$
export TYPELESS_OMARCHY_ACTIVE=1
export PATH="/usr/lib/typeless-omarchy/helpers:$PATH"
typeless_program=/usr/bin/typeless
if [[ ${TYPELESS_OMARCHY_BASE_ONLY:-0} != 1 ]]; then
  if typeless_runtime=$(/usr/lib/typeless-omarchy/runtime/prepare.py); then
    typeless_program=$typeless_runtime
  fi
fi
exec env -u DISPLAY "$typeless_program" --ozone-platform=wayland "$@"
